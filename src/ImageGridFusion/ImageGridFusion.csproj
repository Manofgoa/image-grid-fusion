<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 2004: the WinRT APIs that preview PDFs (Windows.Data.Pdf) and videos (Windows.Media.Editing). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>ImageGridFusion</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Also embedded, so the window and the tray icon load it without going through the exe's resources. -->
  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="ImageGridFusion.app.ico" />
  </ItemGroup>

  <!-- The tags' vocabulary (workfiles/20261027-image-content-analysis.md § Tags). -->
  <ItemGroup>
    <EmbeddedResource Include="Explorer\VisionTags.txt" LogicalName="ImageGridFusion.Explorer.VisionTags.txt" />
  </ItemGroup>

  <!--
    RapidOCR, the file explorer's second OCR pass (workfiles/20261013-complementary-ocr-passes.md § RapidOCR Download):
    the managed assemblies only. Its models (RapidOcrNet's build target) and the native DLLs of ONNX Runtime and
    SkiaSharp are never shipped: downloaded on demand into ocr-engine\ (Explorer/OcrEngineFiles.cs, which pins
    these same versions and the files' hashes — change them together).
  -->
  <ItemGroup>
    <PackageReference Include="RapidOcrNet" Version="4.2.0" ExcludeAssets="build;buildTransitive" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.29.0" ExcludeAssets="native;build;buildTransitive" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.1" ExcludeAssets="all" />
  </ItemGroup>

  <!-- SigLIP 2's tokenizer, Gemma's SentencePiece (workfiles/20261027-image-content-analysis.md § Models): managed only, its model downloaded with the vision engine. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.1" />
  </ItemGroup>

  <!-- dotnet publish -c Release: one small .exe, precompiled for fast startup; needs the .NET 10 Desktop Runtime. -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

</Project>
